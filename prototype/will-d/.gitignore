# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Build / packaging
build/
dist/
*.egg-info/

# Experiment artifacts
#
# Training and site outputs are regenerable locally -- train via README
# "How to train", view via ./view.sh -- so none of it is committed.
results/
site/
data/
*.pt
*.pth
*.mp4

# macOS
.DS_Store

# Editors
.idea/
.vscode/
*.swp
# Sweep ledgers are progress state, not results; they are rebuilt by the runner.
results/*/ledger.json

# Rendered visualisations and the site built from them. Both are derived: the
# videos come from the gitignored checkpoints via scripts/render_videos.py, and
# site/ is a copy of them produced by scripts/build_site.py. Rebuild either with
# `make videos` / `make site` rather than committing megabytes of x264.
results/videos/
site/
